#!/bin/sh
# rns — one entry point for the whole appliance.
#
#   rns status | packages | sales | payments | mint | verify | ...
#       the gateway engine CLI (the same rns-ctl.sh the phone runs)
#
#   rns os <subcommand>
#       the RNS-OS platform controller (network, radio, config, diagnostics)
#
# On the phone the operator types:
#     su -c 'sh /data/adb/modules/RNS_Hotspot/rns/bin/rns-ctl.sh status'
# Here it is just `rns status`.

set -u

# The systemd units load these from /etc/rns/env; an interactive shell does
# not, so load them here too. Otherwise BB is empty and the engine's
# "$BB" sed ... calls try to execute a command named "".
if [ -f /etc/rns/env ]; then
  # shellcheck disable=SC1091
  . /etc/rns/env
fi
export RNS_HOME=${RNS_HOME:-/usr/local/lib/rns}
export RNS_DATA=${RNS_DATA:-/var/lib/rns}
export RNS_LAB=${RNS_LAB:-0}
export BB=${BB:-/bin/busybox}
export RNS_BB=$BB

if [ "${1:-}" = "os" ]; then
  shift
  exec /usr/local/sbin/rns-os-ctl "${1:-help}" "${@:2}"
fi

exec /bin/sh "$RNS_HOME/bin/rns-ctl.sh" "$@"
