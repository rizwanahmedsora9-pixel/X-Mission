# Rendered by: rns-os-ctl render   (source: /var/lib/rns/config.env)
# Do not edit this file by hand — change the values in the staff panel or with
# `rns os config KEY=VALUE`, then run `rns os render`.

interface=${GUEST_IF}
driver=nl80211
ctrl_interface=/var/run/hostapd
ctrl_interface_group=0

ssid=${SSID}
channel=${CHANNEL}
hw_mode=${HW_MODE}
max_num_sta=${MAX_STA}

# Open network, exactly like the phone's hotspot: customers get internet
# access by entering a voucher code on the captive portal, not by knowing a
# Wi-Fi password.
ignore_broadcast_ssid=0
ap_isolate=1

# No WPA on purpose. The voucher gate is the access control.
# (hostapd rejects a config that enables wpa without a passphrase.)
