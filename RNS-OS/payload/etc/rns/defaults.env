# RNS-OS defaults for the keys the phone version did not need.
#
# These are copied into /var/lib/rns/config.env on first boot for any key the
# operator has not set yet. The gateway engine reads them with cfg_get, so an
# empty value always falls back to the default coded in the engine.
#
# The phone-specific keys (SSID, CHANNEL, HW_MODE, MAX_STA, LAN_IF, WAN_IF,
# PORTAL_PORT, BRAND, SHOP, JAZZCASH_*, EASYPAISA_*, PAY_AUTO_VERIFY) are
# owned by the engine and are NOT repeated here.

# --- guest (customer) network ------------------------------------------------
# Address of this box on the customer side. dnsmasq hands out leases from this
# subnet and the captive portal redirects port 80 to PORTAL_PORT on it.
GUEST_IP=192.168.50.1
GUEST_MASK=255.255.255.0
DHCP_START=192.168.50.20
DHCP_END=192.168.50.250
DHCP_LEASE=12h

# Which interface customers are plugged into / which radio hostapd drives.
# The engine defaults to the Android hotspot name ap0, so RNS-OS must always
# set this explicitly.
#
#   VirtualBox VM      enp0s8 is the second NIC (Adapter 2). The first (NIC1,
#                      enp0s3) is the uplink and must NOT be used here.
#   real x86 box       check with `ip -br link` and set it in `rns os setup`.
#
# firstboot checks that this interface exists and, if it does not, picks the
# spare wired adapter it can see instead — so a VM whose NICs were renamed
# still comes up working. `rns os status` prints what was chosen.
GUEST_IF=enp0s8

# wifi | wired | off
#   wifi  - hostapd broadcasts the SSID on a USB Wi-Fi adapter passed into the
#           VM. Needs a Linux-supported dongle (VirtualBox > Devices > USB).
#   wired - customers reach the portal over Ethernet on GUEST_IF. This is the
#           default because it works in a VirtualBox VM with no extra hardware:
#           Adapter 2 is the customer side, so you can open the portal from the
#           host browser and test vouchers end to end.
#   off   - portal and billing only, no customer network at all.
#
# Switch with:  rns os mode wired | wifi | off
RNS_MODE=wired

# Internet uplink. "auto" takes the interface that owns the default route.
WAN_IF=auto

# Allow staff to open the panel from any address on the guest network, not
# just from this box. 0 = this box only (the phone's default), 1 = any LAN IP.
#
# RNS-OS defaults to 1 because the operator is never sitting at the appliance:
# in a VM the panel is opened from the host browser, through VirtualBox NAT
# (whose source address is not "this box"), and on a real box it is opened from
# a laptop on the customer LAN. The panel still needs the staff password.
# Set it back to 0 if you want /admin to answer only from the box itself.
ADMIN_LAN=1
